{
  "manifest_version": 3,
  "name": "PhishShield X",
  "version": "0.1.0",
  "description": "AI-powered phishing protection companion. Backend-scored, explainable warnings.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://localhost:3000/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "PhishShield X", "default_popup": "popup.html" }
}
