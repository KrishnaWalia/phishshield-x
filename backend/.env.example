# ==============================================================================
# PHISHSHIELD X - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and configure the respective values.
# NEVER commit .env to version control or expose production credentials.
# ==============================================================================

# Database Connection Strings (Neon PostgreSQL)
# DATABASE_URL: Neon pooled connection string for normal application queries
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/phishshield?sslmode=require

# DIRECT_URL: Neon direct connection string used by Alembic for schema migrations
DIRECT_URL=postgresql+psycopg://USER:PASSWORD@HOST.REGION.aws.neon.tech/phishshield?sslmode=require

# Groq AI Service (Optional - detection continues locally if disabled or unavailable)
PHISHSHIELD_GROQ_API_KEY=api_key_here
PHISHSHIELD_GROQ_MODEL=openai/gpt-oss-120b
PHISHSHIELD_AI_ENABLED=true

# Server Configuration & Public Base URLs
PHISHSHIELD_HOST=127.0.0.1
PHISHSHIELD_PORT=8000
PHISHSHIELD_DEBUG=false

# Client Integration Base URLs (for reference / CORS / documentation)
NEXT_PUBLIC_PHISHSHIELD_API_BASE_URL=http://127.0.0.1:8000
PHISHSHIELD_EXTENSION_API_BASE_URL=http://127.0.0.1:8000
